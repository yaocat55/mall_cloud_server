    <sql id="paginationSql">
        <if test="pageSize > 0">
           LIMIT #{pageBegin} , #{pageSize}
        </if>
    </sql>

	<sql id="selectReconBatchColumn">
         id,
         batch_no,
         channel_code,
         trade_date,
         file_name,
         file_path,
         channel_count,
         channel_total_amount,
         platform_count,
         platform_total_amount,
         diff_count,
         diff_total_amount,
         status,
         begin_time,
         end_time,
         error_msg,
         version,
         create_user_id,
         create_user_name,
         create_time,
         update_user_id,
         update_user_name,
         update_time,
         is_del
    </sql>

    <sql id="queryWhere">
        <where>
            
            <if test="id != null ">
                AND id = #{id}
            </if>
            
            <if test="batchNo != null  and batchNo != ''">
                AND batch_no = #{batchNo}
            </if>
            
            <if test="channelCode != null  and channelCode != ''">
                AND channel_code = #{channelCode}
            </if>
            
            <if test="tradeDate != null ">
                AND trade_date = #{tradeDate}
            </if>
            
            <if test="fileName != null  and fileName != ''">
                AND file_name = #{fileName}
            </if>
            
            <if test="filePath != null  and filePath != ''">
                AND file_path = #{filePath}
            </if>
            
            <if test="channelCount != null ">
                AND channel_count = #{channelCount}
            </if>
            
            <if test="channelTotalAmount != null ">
                AND channel_total_amount = #{channelTotalAmount}
            </if>
            
            <if test="platformCount != null ">
                AND platform_count = #{platformCount}
            </if>
            
            <if test="platformTotalAmount != null ">
                AND platform_total_amount = #{platformTotalAmount}
            </if>
            
            <if test="diffCount != null ">
                AND diff_count = #{diffCount}
            </if>
            
            <if test="diffTotalAmount != null ">
                AND diff_total_amount = #{diffTotalAmount}
            </if>
            
            <if test="status != null ">
                AND status = #{status}
            </if>
            
            <if test="beginTime != null ">
                AND begin_time = #{beginTime}
            </if>
            
            <if test="endTime != null ">
                AND end_time = #{endTime}
            </if>
            
            <if test="errorMsg != null  and errorMsg != ''">
                AND error_msg = #{errorMsg}
            </if>
            
            <if test="version != null ">
                AND version = #{version}
            </if>
            
            <if test="createUserId != null ">
                AND create_user_id = #{createUserId}
            </if>
            
            <if test="createUserName != null  and createUserName != ''">
                AND create_user_name = #{createUserName}
            </if>
            
            <if test="createTime != null ">
                AND create_time = #{createTime}
            </if>
            
            <if test="updateUserId != null ">
                AND update_user_id = #{updateUserId}
            </if>
            
            <if test="updateUserName != null  and updateUserName != ''">
                AND update_user_name = #{updateUserName}
            </if>
            
            <if test="updateTime != null ">
                AND update_time = #{updateTime}
            </if>
                        AND is_del = 0
        </where>
    </sql>

    <select id="findById" parameterType="Long"
            resultMap="ReconBatchResult">
        SELECT
        <include refid="selectReconBatchColumn"/>
        FROM recon_batch
        WHERE id = #{id} AND is_del = 0
    </select>

    <select id="searchByCondition"
            parameterType="cn.net.mall.pay.entity.ReconBatchConditionEntity"
            resultMap="ReconBatchResult">
        SELECT
        <include refid="selectReconBatchColumn"/>
        FROM recon_batch
        <include refid="queryWhere"/>
        <include refid="cn.net.mall.pay.mapper.BaseMapper.paginationSql"/>
    </select>

    <select id="searchCount"
            parameterType="cn.net.mall.pay.entity.ReconBatchConditionEntity"
            resultType="int">
        SELECT
        COUNT(*)
        FROM recon_batch
        <include refid="queryWhere"/>
    </select>


    <update id="update" parameterType="cn.net.mall.pay.entity.ReconBatchEntity">
        UPDATE recon_batch
        <trim prefix="SET" suffixOverrides=",">
                                                        
                    <if test="batchNo != null  and batchNo != ''">
                        batch_no = #{batchNo},
                    </if>

                                            
                    <if test="channelCode != null  and channelCode != ''">
                        channel_code = #{channelCode},
                    </if>

                                            
                    <if test="tradeDate != null ">
                        trade_date = #{tradeDate},
                    </if>

                                            
                    <if test="fileName != null  and fileName != ''">
